<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishSingleFile>false</PublishSingleFile>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>NotifyIsland</RootNamespace>
    <AssemblyName>NotifyIsland</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.250205002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
  </ItemGroup>
  <!-- Unpackaged publish omits the app PRI unless MSIX publish wiring is imported
       (WindowsAppSDK #3451/#3718/#6720). Without resources.pri, WinUI APPCRASHes
       in Microsoft.UI.Xaml.dll (0xc000027b / combase 0x80004005). -->
  <Target Name="IncludeAppPriInPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <PropertyGroup>
      <_AppPri Condition="Exists('$(OutputPath)resources.pri')">$(OutputPath)resources.pri</_AppPri>
      <_AppPri Condition="'$(_AppPri)' == '' and Exists('$(OutputPath)$(AssemblyName).pri')">$(OutputPath)$(AssemblyName).pri</_AppPri>
      <_AppPri Condition="'$(_AppPri)' == '' and Exists('$(OutDir)resources.pri')">$(OutDir)resources.pri</_AppPri>
      <_AppPri Condition="'$(_AppPri)' == '' and Exists('$(OutDir)$(AssemblyName).pri')">$(OutDir)$(AssemblyName).pri</_AppPri>
    </PropertyGroup>
    <ItemGroup Condition="'$(_AppPri)' != ''">
      <ResolvedFileToPublish Include="$(_AppPri)">
        <RelativePath>resources.pri</RelativePath>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </ResolvedFileToPublish>
    </ItemGroup>
  </Target>
</Project>
