<Window
    x:Class="NotifyIsland.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="Transparent">
        <Border
            x:Name="GlowBorder"
            Width="232"
            Height="36"
            CornerRadius="18"
            BorderThickness="2"
            BorderBrush="#00000000"
            Background="Transparent"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Opacity="0"
            IsHitTestVisible="False" />
        <Border
            x:Name="Pill"
            Width="224"
            Height="32"
            CornerRadius="16"
            BorderThickness="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            PointerPressed="Pill_PointerPressed"
            PointerEntered="Pill_PointerEntered"
            PointerExited="Pill_PointerExited"
            RightTapped="Pill_RightTapped">
            <Border.RenderTransform>
                <ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1" CenterX="112" CenterY="16" />
            </Border.RenderTransform>
            <Grid>
                <StackPanel
                    x:Name="MainRow"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="6"
                    Padding="8,0">
                    <StackPanel Orientation="Vertical" VerticalAlignment="Center" Spacing="1">
                        <TextBlock
                            x:Name="ClockText"
                            FontFamily="Segoe UI Variable"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="#E6E6EB"
                            VerticalAlignment="Center"
                            Text="00:00" />
                        <ProgressBar
                            x:Name="MinuteArc"
                            Width="44"
                            Height="2"
                            Minimum="0"
                            Maximum="60"
                            Value="0"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel
                        x:Name="WeatherCompact"
                        Orientation="Horizontal"
                        Spacing="3"
                        VerticalAlignment="Center">
                        <FontIcon x:Name="WeatherGlyph" Glyph="&#xE706;" FontSize="12" Foreground="#E6E6EB" />
                        <Image x:Name="WeatherImage" Width="14" Height="14" Visibility="Collapsed" />
                        <TextBlock
                            x:Name="WeatherTemp"
                            FontSize="11"
                            Foreground="#E6E6EB"
                            VerticalAlignment="Center"
                            Text="18°" />
                    </StackPanel>
                    <FontIcon x:Name="StateIcon" Glyph="&#xEA8F;" FontSize="14" Foreground="#E6E6EB" />
                    <Image x:Name="StateImage" Width="16" Height="16" Visibility="Collapsed" />
                    <Border
                        x:Name="Badge"
                        MinWidth="16"
                        Height="16"
                        CornerRadius="8"
                        Padding="4,0"
                        Background="#E81123"
                        Visibility="Collapsed"
                        VerticalAlignment="Center">
                        <TextBlock
                            x:Name="BadgeText"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="White"
                            VerticalAlignment="Center"
                            HorizontalAlignment="Center"
                            Text="0" />
                    </Border>
                    <Ellipse
                        x:Name="Dot"
                        Width="8"
                        Height="8"
                        Fill="#66FFFFFF"
                        Opacity="1" />
                </StackPanel>
                <Border
                    x:Name="WeatherExpanded"
                    Background="#CC1C1C1E"
                    CornerRadius="10"
                    Padding="8,4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon x:Name="WeatherGlyphExp" Glyph="&#xE706;" FontSize="14" Foreground="#E6E6EB" />
                        <Image x:Name="WeatherImageExp" Width="16" Height="16" Visibility="Collapsed" />
                        <TextBlock x:Name="WeatherDesc" FontSize="11" Foreground="#E6E6EB" VerticalAlignment="Center" Text="Clear" />
                        <TextBlock x:Name="WeatherFeels" FontSize="10" Foreground="#A0A0A8" VerticalAlignment="Center" Text="feels 16°" />
                        <TextBlock x:Name="WeatherRange" FontSize="10" Foreground="#A0A0A8" VerticalAlignment="Center" Text="12° / 21°" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
