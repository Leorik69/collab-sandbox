<Window
    x:Class="NotifyIsland.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Background="Transparent">
        <!-- Orange keylineGlow host (CC: #FF9F0A, not #0A84FF) -->
        <Border
            x:Name="GlowBorder"
            Width="184"
            Height="36"
            CornerRadius="18"
            BorderThickness="2"
            BorderBrush="#28FFFFFF"
            Background="Transparent"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,4,0,0"
            Opacity="0"
            IsHitTestVisible="False" />
        <Border
            x:Name="Pill"
            Width="180"
            Height="34"
            CornerRadius="17"
            BorderThickness="1"
            BorderBrush="#28FFFFFF"
            Background="#080808"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Margin="0,4,0,0"
            PointerPressed="Pill_PointerPressed"
            PointerEntered="Pill_PointerEntered"
            PointerExited="Pill_PointerExited"
            RightTapped="Pill_RightTapped"
            SizeChanged="Pill_SizeChanged">
            <Border.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="PillScale" ScaleX="1" ScaleY="1" CenterX="88" CenterY="16" />
                    <TranslateTransform x:Name="PillNudge" />
                </TransformGroup>
            </Border.RenderTransform>
            <StackPanel
                VerticalAlignment="Center"
                HorizontalAlignment="Stretch"
                Spacing="2"
                Padding="12,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- CompactLeading: clock (DI-like name; not from Packt widget sources) -->
                    <StackPanel
                        x:Name="CompactLeading"
                        Grid.Column="0"
                        Orientation="Vertical"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Spacing="1">
                        <Grid HorizontalAlignment="Left">
                            <TextBlock
                                x:Name="ClockGlowText"
                                FontFamily="Segoe UI Variable Display"
                                FontSize="13"
                                FontWeight="Bold"
                                MinWidth="80"
                                Foreground="#FF9F0A"
                                Opacity="0"
                                IsHitTestVisible="False"
                                Text="00:00" />
                            <TextBlock
                                x:Name="ClockText"
                                FontFamily="Segoe UI Variable Display"
                                FontSize="12"
                                FontWeight="SemiBold"
                                MinWidth="80"
                                Foreground="#FFFFFF"
                                Typography.NumeralAlignment="Tabular"
                                Text="00:00" />
                        </Grid>
                        <ProgressBar
                            x:Name="MinuteArc"
                            Width="44"
                            Height="2"
                            Minimum="0"
                            Maximum="60"
                            Value="0"
                            Foreground="#FF9F0A"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <!-- CompactTrailing: weather + Fluent glyph -->
                    <StackPanel
                        x:Name="CompactTrailing"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right">
                        <StackPanel x:Name="WeatherCompact" Orientation="Horizontal" Spacing="3" VerticalAlignment="Center">
                            <FontIcon x:Name="WeatherGlyph" Glyph="&#xE706;" FontSize="12" Foreground="#F5F5F7" Visibility="Collapsed" />
                            <Image x:Name="WeatherGlyphImage" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock x:Name="WeatherTemp" FontSize="11" Foreground="#F5F5F7" VerticalAlignment="Center" Text="18°" />
                        </StackPanel>
                        <FontIcon x:Name="StateIcon" Glyph="&#xEA8F;" FontSize="13" Foreground="#F5F5F7" Visibility="Collapsed" />
                        <Image x:Name="StateIconImage" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                        <Border
                            x:Name="Badge"
                            MinWidth="16"
                            Height="16"
                            CornerRadius="8"
                            Padding="4,0"
                            Background="#FF9F0A"
                            Visibility="Collapsed"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Name="BadgeText"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="Black"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Text="0" />
                        </Border>
                        <Ellipse x:Name="Dot" Width="8" Height="8" Fill="#FF9F0A" Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
                <!-- Expanded extras stay in-tree; opacity morphs with Width/Height (clipped to pill). -->
                <Grid x:Name="ExpandedRegion" Opacity="0" IsHitTestVisible="False">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel x:Name="ExpandedLeading" Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <StackPanel x:Name="AppIcons" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" />
                        <FontIcon x:Name="WeatherGlyphExp" Glyph="&#xE706;" FontSize="12" Foreground="#F5F5F7" Visibility="Collapsed" />
                        <Image x:Name="WeatherGlyphExpImage" Width="12" Height="12" Stretch="Uniform" VerticalAlignment="Center" />
                        <TextBlock x:Name="WeatherDesc" FontSize="11" Foreground="#F5F5F7" VerticalAlignment="Center" Text="Clear" />
                    </StackPanel>
                    <StackPanel x:Name="ExpandedTrailing" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock x:Name="WeatherFeels" FontSize="10" Foreground="#C8C8CC" VerticalAlignment="Center" Text="feels 16°" />
                        <TextBlock x:Name="WeatherRange" FontSize="10" Foreground="#C8C8CC" VerticalAlignment="Center" Text="12° / 21°" />
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="OverlayPanel" Spacing="4" Visibility="Collapsed" Margin="0,4,0,2">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="OverlayTitle" FontSize="13" FontWeight="SemiBold" Foreground="#FFFFFF" TextTrimming="CharacterEllipsis" Text="Обзор" />
                            <TextBlock x:Name="OverlaySubtitle" FontSize="11" Foreground="#C8C8CC" TextTrimming="CharacterEllipsis" Text="" />
                        </StackPanel>
                        <Button x:Name="MediaPlay" Grid.Column="1" Width="32" Height="32" Padding="0" Click="MediaPlay_Click"
                                Background="Transparent" BorderThickness="0" AutomationProperties.Name="Воспроизведение"
                                ToolTipService.ToolTip="Воспроизведение">
                            <FontIcon x:Name="MediaPlayIcon" Glyph="&#xE768;" FontSize="12" Foreground="#3D9CF0" />
                        </Button>
                    </Grid>
                    <ProgressBar x:Name="OverlayProgress" Height="4" Minimum="0" Maximum="100" Foreground="#3D9CF0" Background="#22FFFFFF" />
                    <TextBlock x:Name="OverlayTimer" FontSize="18" FontWeight="SemiBold" Foreground="#FFFFFF" Visibility="Collapsed" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
