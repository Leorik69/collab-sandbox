<Window
    x:Class="NotifyIsland.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="NotifyIsland">
    <Grid Padding="20" ColumnSpacing="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>
        <ScrollViewer Grid.Column="0">
            <StackPanel Spacing="12">
                <Grid>
                    <TextBlock Text="Настройки острова" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <ToggleSwitch x:Name="ThemeToggle" Header="Тёмное окно" HorizontalAlignment="Right" Toggled="Theme_Toggled" />
                </Grid>
                <TextBlock Text="Остров" FontWeight="SemiBold" />
                <Slider x:Name="OpacitySlider" Header="Прозрачность" Minimum="20" Maximum="100" StepFrequency="1" ValueChanged="AnyChanged" />
                <TextBlock Text="Цвет" FontWeight="SemiBold" />
                <ComboBox x:Name="PackBox" Header="Тема иконок (пресет палитры)" SelectionChanged="Pack_Changed" />
                <TextBox x:Name="BgBox" Header="Заливка (#RRGGBB)" TextChanged="AnyChanged" />
                <TextBox x:Name="TextBoxHex" Header="Текст часов" TextChanged="AnyChanged" />
                <TextBox x:Name="AccentBox" Header="Акцент" TextChanged="AnyChanged" />
                <TextBlock Text="Свечение" FontWeight="SemiBold" />
                <ComboBox x:Name="GlowBox" Header="Режим" SelectionChanged="AnyChanged" />
                <TextBox x:Name="GlowHexBox" Header="Цвет свечения" TextChanged="AnyChanged" />
                <Slider x:Name="GlowStrSlider" Header="Сила свечения" Minimum="0" Maximum="100" StepFrequency="1" ValueChanged="AnyChanged" />
                <TextBlock Text="Бордер" FontWeight="SemiBold" />
                <TextBox x:Name="BorderHexBox" Header="Цвет" TextChanged="AnyChanged" />
                <Slider x:Name="BorderSlider" Header="Толщина" Minimum="0" Maximum="4" StepFrequency="0.5" ValueChanged="AnyChanged" />
                <TextBlock Text="Анимация" FontWeight="SemiBold" />
                <ComboBox x:Name="AnimBox" Header="Уведомление" SelectionChanged="AnyChanged" />
                <TextBlock Text="Часы" FontWeight="SemiBold" />
                <ComboBox x:Name="ClockBox" Header="Стиль часов" SelectionChanged="AnyChanged" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Демо уведомление" Click="Demo_Click" />
                    <Button Content="Сброс unread" Click="Clear_Click" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Column="1" CornerRadius="16" Padding="16" VerticalAlignment="Top" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Spacing="8">
                <TextBlock Text="Предпросмотр" Opacity="0.7" />
                <Border x:Name="PreviewPill" Height="32" CornerRadius="16" HorizontalAlignment="Stretch" Padding="12,0">
                    <TextBlock x:Name="PreviewClock" Text="21:22" VerticalAlignment="Center" FontWeight="SemiBold" />
                </Border>
                <TextBlock x:Name="PreviewHint" FontSize="11" Opacity="0.6" TextWrapping="Wrap" Text="Слайдеры применяются сразу." />
            </StackPanel>
        </Border>
    </Grid>
</Window>
