<Window
    x:Class="NotifyIsland.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid x:Name="Root" Padding="16,12" Width="340">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="10">
                <TextBlock Text="Настройки" FontSize="18" FontWeight="SemiBold" />

                <TextBlock Text="Прозрачность" FontSize="12" Opacity="0.55" />
                <ComboBox x:Name="TransparencyBox" HorizontalAlignment="Stretch" SelectionChanged="OnCombo">
                    <ComboBoxItem Content="Solid" Tag="Solid" />
                    <ComboBoxItem Content="Soft" Tag="Soft" />
                    <ComboBoxItem Content="Glass" Tag="Glass" />
                </ComboBox>

                <TextBlock Text="Палитра" FontSize="12" Opacity="0.55" />
                <TextBlock Text="Фон" FontSize="11" Opacity="0.7" />
                <StackPanel x:Name="BgRow" Orientation="Horizontal" Spacing="6" />
                <TextBlock Text="Акцент" FontSize="11" Opacity="0.7" />
                <StackPanel x:Name="AccentRow" Orientation="Horizontal" Spacing="6" />

                <TextBlock Text="Свечение" FontSize="12" Opacity="0.55" />
                <TextBlock Text="Остров" FontSize="11" Opacity="0.7" />
                <Slider x:Name="IslandGlowSlider" Minimum="0" Maximum="1" StepFrequency="0.05" ValueChanged="OnSlider" />
                <TextBlock Text="Часы" FontSize="11" Opacity="0.7" />
                <Slider x:Name="ClockGlowSlider" Minimum="0" Maximum="1" StepFrequency="0.05" ValueChanged="OnSlider" />

                <TextBlock Text="Бордерлайн" FontSize="12" Opacity="0.55" />
                <StackPanel x:Name="BorderRow" Orientation="Horizontal" Spacing="6" />
                <TextBlock Text="Толщина" FontSize="11" Opacity="0.7" />
                <Slider x:Name="BorderSlider" Minimum="0.5" Maximum="3" StepFrequency="0.5" ValueChanged="OnSlider" />

                <TextBlock Text="Анимация" FontSize="12" Opacity="0.55" />
                <ComboBox x:Name="AnimBox" HorizontalAlignment="Stretch" SelectionChanged="OnCombo">
                    <ComboBoxItem Content="Pulse" Tag="Pulse" />
                    <ComboBoxItem Content="Glow" Tag="Glow" />
                    <ComboBoxItem Content="SoftBounce" Tag="SoftBounce" />
                    <ComboBoxItem Content="Off" Tag="Off" />
                </ComboBox>

                <ToggleSwitch x:Name="ThemeSwitch" Header="Тема окна" OffContent="Светлая" OnContent="Тёмная" Toggled="OnThemeToggled" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
